# Cache-Control headers for brand/icon assets.
#
# Versioned assets (?v=<hash>) are cached 1 year as immutable: the hash is
# regenerated by `node scripts/update-icon-version.mjs` whenever an icon
# changes, so a new deployment always ships a new URL — no retention.
#
# Bare, unversioned requests (e.g. the browser's automatic /favicon.ico probe,
# or /site.webmanifest) use no-cache + must-revalidate so stale icons are never
# retained across deployments.
#
# Note: Lovable's built-in hosting does not process this file. It is honored by
# external static hosts (Cloudflare Pages, Netlify, etc.) if you migrate.

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: no-cache, must-revalidate

/site.webmanifest
  Cache-Control: no-cache, must-revalidate

/*.json
  Cache-Control: no-cache, must-revalidate
